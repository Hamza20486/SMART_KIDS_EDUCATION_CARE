name: Deploy Smart Kids

on:
  workflow_dispatch:
    inputs:
      target:
        description: Deployment target
        required: true
        type: choice
        options: [staging, production]

permissions:
  contents: read

env:
  VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
  VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}

jobs:
  staging:
    if: inputs.target == 'staging'
    runs-on: ubuntu-latest
    environment: staging
    timeout-minutes: 25
    defaults:
      run:
        working-directory: smart-kids-postgres
    env:
      DATABASE_URL: ${{ secrets.STAGING_DATABASE_URL }}
      PRISMA_MIGRATION_DATABASE_URL: ${{ secrets.STAGING_DIRECT_DATABASE_URL }}
      HEALTHCHECK_TOKEN: ${{ secrets.STAGING_HEALTHCHECK_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: smart-kids-postgres/package-lock.json
      - run: npm ci
      - name: Apply reviewed migrations through the direct connection
        run: npm run db:deploy
      - name: Build and deploy immutable staging artifact
        run: |
          npx vercel pull --yes --environment=preview --token=${{ secrets.VERCEL_TOKEN }}
          npx vercel build --token=${{ secrets.VERCEL_TOKEN }}
          npx vercel deploy --prebuilt --token=${{ secrets.VERCEL_TOKEN }} > deployment-url.txt
      - name: Smoke test staging
        run: |
          export SMOKE_BASE_URL=$(tail -n 1 deployment-url.txt)
          npm run ops:smoke:http

  production:
    if: inputs.target == 'production'
    runs-on: ubuntu-latest
    environment: production
    timeout-minutes: 25
    defaults:
      run:
        working-directory: smart-kids-postgres
    env:
      DATABASE_URL: ${{ secrets.PRODUCTION_DATABASE_URL }}
      PRISMA_MIGRATION_DATABASE_URL: ${{ secrets.PRODUCTION_DIRECT_DATABASE_URL }}
      HEALTHCHECK_TOKEN: ${{ secrets.PRODUCTION_HEALTHCHECK_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: smart-kids-postgres/package-lock.json
      - run: npm ci
      - name: Apply reviewed forward-only migrations
        run: npm run db:deploy
      - name: Build and deploy immutable production artifact
        run: |
          npx vercel pull --yes --environment=production --token=${{ secrets.VERCEL_TOKEN }}
          npx vercel build --prod --token=${{ secrets.VERCEL_TOKEN }}
          npx vercel deploy --prebuilt --prod --token=${{ secrets.VERCEL_TOKEN }} > deployment-url.txt
      - name: Smoke test production
        run: |
          export SMOKE_BASE_URL=$(tail -n 1 deployment-url.txt)
          npm run ops:smoke:http

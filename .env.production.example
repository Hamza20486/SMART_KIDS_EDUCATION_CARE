# Runtime connection must use the managed PostgreSQL pooler.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/smart_kids?sslmode=require&pgbouncer=true"
# Deployment/migration jobs only. Never expose this value to browser or runtime clients.
PRISMA_MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/smart_kids?sslmode=require"

NODE_ENV="production"
SERVICE_NAME="smart-kids-web"
AUTH_SECRET="GENERATE_AT_LEAST_32_RANDOM_BYTES"
AUTH_TRUST_HOST="true"
APP_URL="https://app.example.ma"
HEALTHCHECK_TOKEN="GENERATE_A_SEPARATE_32_BYTE_TOKEN"
LOG_LEVEL="info"

RESEND_API_KEY="SECRET_FROM_RESEND"
EMAIL_FROM="Smart Kids <notifications@example.ma>"

UPSTASH_REDIS_REST_URL="https://YOUR_REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="SECRET_FROM_UPSTASH"

R2_ACCOUNT_ID="CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="R2_PRIVATE_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="R2_PRIVATE_SECRET"
R2_BUCKET="smart-kids-private-production"
# Separate credentials scoped only to the backup bucket.
BACKUP_R2_ACCOUNT_ID="CLOUDFLARE_ACCOUNT_ID"
BACKUP_R2_ACCESS_KEY_ID="R2_BACKUP_ACCESS_KEY"
BACKUP_R2_SECRET_ACCESS_KEY="R2_BACKUP_SECRET"
R2_BACKUP_BUCKET="smart-kids-backups-production"
BACKUP_RETENTION_DAYS="90"

MALWARE_SCAN_WEBHOOK_URL="https://scanner.example.ma/scan"
MALWARE_SCAN_API_KEY="SCANNER_SECRET"

INNGEST_EVENT_KEY="INNGEST_EVENT_KEY"
INNGEST_SIGNING_KEY="INNGEST_SIGNING_KEY"

SENTRY_DSN="https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT"
NEXT_PUBLIC_SENTRY_DSN="https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT"
SENTRY_ORG="organization-slug"
SENTRY_PROJECT="smart-kids"
SENTRY_AUTH_TOKEN="BUILD_ONLY_SOURCE_MAP_UPLOAD_TOKEN"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"

{
  "name": "smart-kids-education-care-postgresql",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude=__tests__/*.integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude=__tests__/*.integration.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check": "npm run lint && npm run i18n:check && npm run typecheck && npm test && npm run build",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:reset": "prisma migrate reset",
    "test:integration": "vitest run __tests__/postgres-isolation.integration.test.ts __tests__/notification-outbox.integration.test.ts __tests__/subscription-limits.integration.test.ts __tests__/phase15-security.integration.test.ts",
    "test:unit": "vitest run --exclude=__tests__/*.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:phase15": "npm run test:coverage && npm run test:integration && npm run test:e2e",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "ops:validate-env": "tsx scripts/ops/validate-production-env.ts",
    "ops:backup": "tsx scripts/ops/backup-postgres.ts",
    "ops:restore": "tsx scripts/ops/restore-postgres.ts",
    "ops:smoke:database": "tsx scripts/ops/smoke-database.ts",
    "ops:smoke:http": "tsx scripts/ops/smoke-http.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "@sentry/nextjs": "^10.70.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "inngest": "^4.18.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "resend": "^6.20.0",
    "sharp-processing": "npm:sharp@^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^4.0.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.5.23",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "overrides": {
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  }

# Runtime PostgreSQL connection. Production must use a pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smart_kids?schema=public"
# Direct connection used only by Prisma migration/restore jobs. Local can use the same URL.
PRISMA_MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smart_kids?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"
HEALTHCHECK_TOKEN="replace-with-a-separate-strong-random-token"
SERVICE_NAME="smart-kids-web"
LOG_LEVEL="debug"

# Managed services. Production validation requires every value below.
RESEND_API_KEY=""
EMAIL_FROM="Smart Kids <no-reply@example.com>"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="smart-kids-private"
BACKUP_R2_ACCOUNT_ID=""
BACKUP_R2_ACCESS_KEY_ID=""
BACKUP_R2_SECRET_ACCESS_KEY=""
R2_BACKUP_BUCKET="smart-kids-backups"
BACKUP_RETENTION_DAYS="90"
MALWARE_SCAN_WEBHOOK_URL=""
MALWARE_SCAN_API_KEY=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Error tracking and source-map upload.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_ENVIRONMENT="staging"
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="staging"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
